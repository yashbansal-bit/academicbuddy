PORT=3000
BASE_URL=http://localhost:3000
DATABASE_PATH=./data/academicbuddy.sqlite
NODE_ENV=development

# Required to send verification, welcome, and password-reset emails.
# Gmail requires 2-Step Verification and a Google App Password (not your account password).
# For another SMTP provider, replace these connection settings with its values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Free local Chat Buddy with Ollama. Install Ollama and run
# `ollama pull qwen2.5:3b` once. Local mode does not use AI_API_KEY.
AI_PROVIDER=ollama
AI_OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
AI_MODEL=qwen2.5:3b

# Optional hosted OpenAI-compatible provider (may incur charges):
# AI_PROVIDER=openai-compatible
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Optional contact address included in Crossref source-search requests.
CROSSREF_MAILTO=
# Optional trusted Crossref-compatible works endpoint (HTTPS; localhost HTTP in development).
# CROSSREF_API_URL=https://api.crossref.org/works

# Optional Google and X OAuth 2.0 sign-in. Configure callback URLs in each
# provider console as BASE_URL/auth/oauth/google/callback and BASE_URL/auth/oauth/x/callback.
# Social sign-in also requires SMTP so new accounts can confirm their email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
